# `.env` is gitignored -- never commit real secrets.
#
# Loaded automatically at startup via application.properties's
# spring.config.import=optional:file:.env[.properties] -- Spring Boot's own
# native config-import mechanism, not a third-party library.

# Required for the Savings Insight Chatbot's Groq-backed generator
# (chatbot.generator=groq). Get a key at https://console.groq.com.
GROQ_API_KEY=

# Required for the chatbot's knowledge-base retrieval via pgvector. Point
# these at the container started by docker-compose.pgvector.yml.
# Leave blank to run the chatbot without cited tips
PGVECTOR_URL=jdbc:postgresql://localhost:5433/postgres
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=postgres

# Optional: move the JWT signing secret here instead of relying on the
# app's existing hardcoded dev-only fallback in application.properties.
JWT_SECRET=
