#!/usr/bin/env sh
set -eu

branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [ "$branch" != "QA" ]; then
  echo "ERROR: Pushes are restricted to branch 'QA'. Current branch: '${branch:-DETACHED}'" >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "${local_ref:-}" ] && continue
  if [ "$remote_ref" != "refs/heads/QA" ]; then
    echo "ERROR: Push target is restricted to refs/heads/QA. Attempted: $remote_ref" >&2
    exit 1
  fi
done
